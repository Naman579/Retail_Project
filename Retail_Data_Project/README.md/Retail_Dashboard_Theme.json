{
  "name": "Retail Sales Analytics Theme",
  "dataColors": [
    "#2E5EE8",
    "#8B3FE8",
    "#F2941F",
    "#1FB6A8",
    "#E8385F",
    "#3FB84F",
    "#F2C41F",
    "#2E9BE8"
  ],
  "background": "#0B0F1A",
  "foreground": "#FFFFFF",
  "tableAccent": "#2E5EE8",
  "good": "#3FB84F",
  "neutral": "#F2C41F",
  "bad": "#E8385F",
  "maximum": "#2E5EE8",
  "center": "#8B3FE8",
  "minimum": "#0B0F1A",
  "null": "#5A6478",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#D9DEEA"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#131A2B" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2A3450" } },
            "radius": 8
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#0B0F1A" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#B9C2D6" } },
            "fontSize": 11
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [
          { "outlineColor": { "solid": { "color": "#2A3450" } } }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } } }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } } }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } }, "gridlineColor": { "solid": { "color": "#2A3450" } } }
        ],
        "valueAxis": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } }, "gridlineColor": { "solid": { "color": "#2A3450" } } }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } }, "gridlineColor": { "solid": { "color": "#2A3450" } } }
        ],
        "valueAxis": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } }, "gridlineColor": { "solid": { "color": "#2A3450" } } }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } }, "gridlineColor": { "solid": { "color": "#2A3450" } } }
        ],
        "valueAxis": [
          { "labelColor": { "solid": { "color": "#D9DEEA" } }, "gridlineColor": { "solid": { "color": "#2A3450" } } }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#131A2B" } } }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "shape": {
      "*": {
        "fill": [
          { "fillColor": { "solid": { "color": "#131A2B" } } }
        ]
      }
    }
  }
}
